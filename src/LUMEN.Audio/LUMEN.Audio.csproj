<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LUMEN.Audio - low-latency audio playback and the audio clock that drives the
    conductor (spec 68). Windows-targeted: backend is NAudio / WASAPI.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Lumen.Audio</RootNamespace>
    <AssemblyName>LUMEN.Audio</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LUMEN.Core\LUMEN.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

</Project>
