<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LUMEN.Core - pure game logic. No engine, no database, no filesystem, no platform APIs.
    Everything here must be unit-testable in isolation (spec §68, §102).
    Deliberately targets plain net8.0 so a Windows-only dependency cannot leak in.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Lumen.Core</RootNamespace>
    <AssemblyName>LUMEN.Core</AssemblyName>
  </PropertyGroup>

</Project>
