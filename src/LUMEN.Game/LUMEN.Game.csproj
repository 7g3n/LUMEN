<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LUMEN.Game - the MonoGame application. Produces LUMEN.exe.
    Engine loop, input providers, UI toolkit, screens, editor, rendering, animation.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Lumen.Game</RootNamespace>
    <AssemblyName>LUMEN</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LUMEN.Core\LUMEN.Core.csproj" />
    <ProjectReference Include="..\LUMEN.Data\LUMEN.Data.csproj" />
    <ProjectReference Include="..\LUMEN.Audio\LUMEN.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled OFL fonts, copied next to the exe (also picked up by portable builds). -->
    <Content Include="..\..\assets\fonts\ChakraPetch-SemiBold.ttf" Link="assets\fonts\ChakraPetch-SemiBold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\fonts\ChakraPetch-Regular.ttf" Link="assets\fonts\ChakraPetch-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\fonts\IBMPlexMono-Medium.ttf" Link="assets\fonts\IBMPlexMono-Medium.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
