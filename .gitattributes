# Normalize line endings: LF in the repo, native on checkout.
* text=auto

*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=crlf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ps1       text eol=lf
*.manifest  text eol=lf
*.editorconfig text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ico binary
*.lumen binary
*.lumenchart binary
*.lumenbackup binary
